#!/bin/sh
# Runs black (Python) and cargo fmt/clippy (Rust) before each commit.
#
# Install with:  git config core.hooksPath .githooks
# Bypass once with: git commit --no-verify

set -e

staged=$(git diff --cached --name-only)

# Check the same four Python adapter trees as hosted CI.
if printf '%s\n' "$staged" | grep -qE '^adapters/(vfsi-fsspec|nfs4fs|vsmb|vsmbfs)/(python|tests)/.*\.(py|pyi)$'; then
    if [ -x .venv/bin/black ]; then
        black=".venv/bin/black"
    else
        black="black"
    fi
    echo "Running black --check..."
    "$black" --check \
        adapters/vfsi-fsspec/python adapters/vfsi-fsspec/tests \
        adapters/nfs4fs/python adapters/nfs4fs/tests \
        adapters/vsmb/python adapters/vsmb/tests \
        adapters/vsmbfs/python adapters/vsmbfs/tests
fi

# Only run the Rust checks when Rust files are staged.
if echo "$staged" | grep -qE '\.rs$'; then
    echo "Running cargo fmt --check..."
    cargo fmt --all -- --check

    echo "Running cargo clippy..."
    cargo clippy --all-targets -- -D warnings
fi
