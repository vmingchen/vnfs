#!/bin/sh
# Runs black (Python) and cargo fmt/clippy (Rust) before each commit.
#
# Install with:  git config core.hooksPath .githooks
# Bypass once with: git commit --no-verify

set -e

staged=$(git diff --cached --name-only)

# Format Python with black whenever a .py/.pyi file is staged.
if echo "$staged" | grep -qE '\.(py|pyi)$'; then
    if [ -x .venv/bin/black ]; then
        black=".venv/bin/black"
    else
        black="black"
    fi
    echo "Running black --check..."
    "$black" --check python/python/nfs4fs python/tests
fi

# Only run the Rust checks when Rust files are staged.
if echo "$staged" | grep -qE '\.rs$'; then
    echo "Running cargo fmt --check..."
    cargo fmt --all -- --check

    echo "Running cargo clippy..."
    cargo clippy --all-targets -- -D warnings
fi
