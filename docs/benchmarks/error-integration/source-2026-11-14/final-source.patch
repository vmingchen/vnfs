 #[cfg(test)]
 mod descriptor_outcome_tests {
     use super::*;
+    #[test]
+    fn live_descriptor_plans_allocate_failure_slots_only_after_rejection() {
+        let Ok(server) = std::env::var("VFSI_NFS_SERVER") else {
+            assert_ne!(std::env::var("VFSI_NFS_REQUIRED").as_deref(), Ok("1"));
+            return;
+        };
+        let minor = std::env::var("VFSI_NFS_MINOR")
+            .unwrap_or_else(|_| "1".into())
+            .parse()
+            .unwrap();
+        let mut fs = NfsVecFs::connect_minor(&server, minor).unwrap();
+        let path = PathBuf::from(format!("/descriptor-plan-storage-{}", std::process::id()));
+        let file = fs
+            .open_raw_impl(&path, libc::O_CREAT | libc::O_TRUNC | libc::O_RDWR, 0o600)
+            .unwrap();
+        fs.write_raw_impl(&file, 0, b"ab").unwrap();
+        let good = ReadOp::new(file.clone(), VfOffset::At(0), 1);
+        let healthy = fs.descriptor_read_plan(std::slice::from_ref(&good));
+        assert_eq!(
+            healthy.errors.capacity(),
+            0,
+            "healthy plans must not reserve failure slots"
+        );
+        assert_eq!(healthy.owners, [0]);
+        let invalid = ReadOp::from_fd(i32::MAX, VfOffset::At(0), 1);
+        let overflow = ReadOp::new(file.clone(), VfOffset::At(u64::MAX), 1);
+        let reads = [
+            good.clone(),
+            invalid,
+            overflow,
+            ReadOp::new(file.clone(), VfOffset::At(1), 1),
+        ];
+        let plan = fs.descriptor_read_plan(&reads);
+        assert_eq!(plan.errors.len(), reads.len());
+        assert!(plan.errors[0].is_none() && plan.errors[3].is_none());
+        for (index, code) in [(1, libc::EBADF), (2, libc::EOVERFLOW)] {
+            let error = plan.errors[index].as_ref().unwrap();
+            assert_eq!(error.state(), FailureState::NotAttempted);
+            assert_eq!(
+                vfsi_core::native_status(error.cause()),
+                Some(vfsi_core::StatusCode::Errno(code as u32))
+            );
+        }
+        assert_eq!(plan.owners, [0, 3]);
+        let outcomes = fs.descriptor_read_results(&reads).unwrap();
+        assert_eq!(outcomes[0].as_ref().unwrap().data, b"a");
+        assert_eq!(outcomes[3].as_ref().unwrap().data, b"b");
+        for index in [1, 2] {
+            assert_eq!(
+                outcomes[index].as_ref().unwrap_err().state(),
+                FailureState::NotAttempted
+            );
+        }
+        fs.close_impl(&file).unwrap();
+        fs.remove_impl(&path, false).unwrap();
+        fs.shutdown().unwrap();
+    }
 
